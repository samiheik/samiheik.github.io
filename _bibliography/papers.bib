@INPROCEEDINGS{Heikkinen2024-vg,
  title       = "The Temporal Moments of The Residential Green Environment
                 Visits Associated with the Weather Observations",
  author      = "Heikkinen, Sami and Väänänen, Ilkka",
  editor      = "Vanhamäki, Susanna and Vitie, Paula",
  booktitle   = "Smart Cities in Smart Regions Conference Proceedings",
  publisher   = "LAB University of Applied Sciences",
  institution = "LAB University of Applied Sciences",
  address     = "Lahti",
  pages       = "183--192",
  abstract    = "In 17 EU Member States, the park is the most commonly cited
                 setting for engaging in sports or other physical activities.
                 However, there is limited data available on the use of
                 residential green areas for recreational purposes and how this
                 usage varies based on different weather conditions. Evidence of
                 the weather on outdoor activities in residential green spaces
                 is scarce. This study aims to explore the relationship between
                 weather observations and visits to the nature reserve. Data
                 includes two open data sets: a) the number of visits to the
                 Lapakisto Nature Reserve in Lahti and b) the weather
                 observations. The first data set was published by the City of
                 Lahti, and the Finnish Meteorological Institute published the
                 second. These two data sets are combined to investigate the
                 association between the weather and the number of visits to the
                 Lapakisto Nature Reserve. The results indicate how the number
                 of visits associated with weather observations fluctuates
                 monthly and between weekdays and weekends. The variation in
                 visitor numbers in different weather observations means
                 different needs for management and service actions produced by
                 the public producers. Consequently, monitoring the number of
                 park visitors, the use of the parks, and changes in the
                 prevailing environmental and ecological values is important to
                 safeguard the supreme quality of nature experiences available
                 in smart and sustainable cities. In conclusion, weather
                 diversity has both positive and negative effects on the use of
                 recreational areas in cities.",
  month       =  dec,
  year        =  2024,
  pdf         = {The-Temporal-Moments-of-The-Residential-Green-Environment-Visits-Associated-with-the-Weather-Observations.pdf}
}

@PHDTHESIS{Heikkinen2025-ms,
  title     = "Using Learning Analytics to Capture Self-Regulation and the
               Complex Temporal Dynamics of its Correlates",
  author    = "Heikkinen, Sami",
  publisher = "University of Eastern Finland",
  address   = "Joensuu",
  abstract  = "This thesis investigates the complex interplay between
               self-regulated learning, student engagement, and learning
               analytics in online educational environments. Through three
               related studies, the research examines how learning analytics can
               support self-regulated learning, how students' self- efficacy
               beliefs influence their learning behaviors, and how engagement
               patterns evolve alongside self-regulation throughout online
               courses. The research employs a mixed-methods approach that
               combines systematic literature review, sequence analysis, process
               mining, and multi- channel clustering techniques. Data were
               collected from multiple sources including learning management
               system trace data, self-reported surveys, and longitudinal
               self-regulated learning measures across various cohorts of
               business students. Key findings reveal that while learning
               analytics interventions show promise in supporting self-regulated
               learning, only 46\% demonstrated positive impacts on learning
               outcomes. The research identified distinct patterns in how
               students with different self-efficacy beliefs approach online
               learning, with high self-efficacy students demonstrating more
               varied and 8 adaptive learning tactics. Analysis of engagement
               patterns revealed three distinct clusters of students:
               low-regulating improvers (4.85\%), disengaged low regulators
               (44.85\%), and high-regulating improvers (50.30\%), each showing
               different trajectories in their self-regulation development. The
               thesis makes several theoretical and practical contributions to
               the field of educational technology. It elucidates how
               self-regulation and engagement co-evolve in online learning
               environments, provides evidence- based recommendations for
               designing learning analytics interventions, and demonstrates the
               value of combining multiple analytical approaches to understand
               student learning processes. These findings have important
               implications for the design of online courses and learning
               support systems, particularly their adaptation to support
               students with varying levels of self- regulation skills and
               engagement patterns.",
  month     =  jun,
  year      =  2025,
  school    = "University of Eastern Finland",
  language  = "en",
  pdf       = {sami-phd-thesis.pdf},
  selected  = {true}
}

